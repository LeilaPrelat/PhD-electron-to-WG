// parametrization of a ribbon with rounded edges and trans. invariance along z
// external parameters:
//     W   = total width      || x
//     h   = total thickness  || y
//     s   = rounding radius  (s<h/2)
//     N   = the total number of parametrization points is N+50
//     mu2 = material inside ribbon --> Si
//     mu1 = material outside ribbon --> Air
//     (x0,y0) = central point in the ribbon --> (0,0)

L1=2*W1+2*h1-8*s1+2*pi*s1

ox-flat-end mu2 mu1 x01 y01 h1 W1/2 s1 (h1/L1)*N+5 (W1/2/L1)*N+5 (pi*s1/L1)*N+5
xo-flat-end mu2 mu1 x01 y01 h1 W1/2 s1 (h1/L1)*N+5 (W1/2/L1)*N+5 (pi*s1/L1)*N+5

L2=2*W2+2*h2-8*s2+2*pi*s2

ox-flat-end mu3 mu1 x02 y02 h2 W2/2 s2 (h2/L2)*N+5 (W2/2/L2)*N+5 (pi*s2/L2)*N+5
xo-flat-end mu3 mu1 x02 y02 h2 W2/2 s2 (h2/L2)*N+5 (W2/2/L2)*N+5 (pi*s2/L2)*N+5

// write-geometry bo1.dat  write-regions 400 bo2.dat  end
// density bo2.dat - 0 1 2 3 a a a a a a 0 500 250 0 0 bo1.dat ; open bo2.gif

end
