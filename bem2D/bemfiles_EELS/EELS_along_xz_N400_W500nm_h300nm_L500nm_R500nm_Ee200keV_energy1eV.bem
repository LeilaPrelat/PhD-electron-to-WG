
N=400
W=500
h=300
L=500
R=500
Eelectron_keV=200
E1eV=1

delta=10
NE=1
 

x0=0 // rectangular waveguide center at 0,0
z0=0
EeV=Eelectron_keV*1e3 // electron energy in eV
zmax=h+delta
zmin=-h-R-delta

xmin=-L-W/2-delta
xmax=L+W/2+delta
 
Nz=400


photon-energy E1eV E1eV NE
grid xmin xmax Nz zmin zmax Nz                    // position of the electron , dont put a grid with EELS, changes the position of the electron
incident-electron-z EeV 0 h+50                     // the electron is everywhere if I put a grid 

include rectangular_wg_substrate.bem

begin-virtual-structure                          // close open structures 
add-arc 33 11 0 0  R L+W/2  0 -180 0 N4 
     

begin-calculation
calc EELS datfiles_EELS/EELS_along_xz_N400_W500nm_h300nm_L500nm_R500nm_Ee200keV_energy1eV.dat
end-calculation                                                  


end
